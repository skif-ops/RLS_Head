# Package source-binding compares working-tree bytes with Linux CI outputs.
.github/workflows/hil-r1.yml text eol=lf
hardware/system_carrier/** text=auto eol=lf
hardware/system_carrier/altium/import_attempts/ci587_2026-10-21_evt_locks/equivalence_diagnostic/* -text
# Equivalence receipts bind exact native-export bytes by SHA-256.
hardware/system_carrier/altium/equivalence/* binary
# Manufacturing packages bind exact exporter bytes and their SHA-256 values.
hardware/system_carrier/altium/release/pilot_r1/** -text
hardware/system_carrier/altium/release/pilot_r1/**/*.pdf binary
hardware/system_carrier/altium/release/pilot_r1/**/*.zip binary
hardware/system_carrier/altium/release/*.pdf binary
hardware/system_carrier/altium/release/*.zip binary
tools/generate_system_carrier_schematic.py text eol=lf
tools/generate_system_carrier_symbols.py text eol=lf
tools/kicad_netlist_baseline.py text eol=lf
tools/validate_system_carrier_cad_scaffold.py text eol=lf

# Native Altium binary containers: never apply text conversion or textual merge/diff.
*.SchDoc binary
*.PcbDoc binary
*.SchLib binary
*.PcbLib binary
*.IntLib binary
*.schdoc binary
*.pcbdoc binary
*.schlib binary
*.pcblib binary
*.intlib binary

# Altium project files are INI-style text.
*.PrjPcb text eol=lf
*.prjpcb text eol=lf
